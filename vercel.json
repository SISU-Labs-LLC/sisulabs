{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "next build",
  "rewrites": [
    {
      "source": "/degreeos",
      "destination": "https://sisu-command.vercel.app/command/degreeos"
    },
    {
      "source": "/command",
      "destination": "https://sisu-command.vercel.app/command"
    },
    {
      "source": "/command/:path*",
      "destination": "https://sisu-command.vercel.app/command/:path*"
    }
  ]
}
